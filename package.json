  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "ai-agents",
    "multi-agent",
    "claude-code",
    "cursor",
    "antigravity",
    "codex",
    "deepseek",
    "coordination",
    "agent-skills"
  ],
  "bin": {
    "agent-comms": "./server/cli.mjs",
    "agent-comms-mcp": "./server/mcp.mjs"
  },
  "files": [
    "server/",
    "scripts/",
    "skills/",
    "rules/",
    "plugin.json",
    ".claude-plugin/",
    ".cursor-plugin/",
    ".mcp.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "install:harness": "node scripts/install.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
